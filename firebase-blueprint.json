{
  "entities": {
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile indexed by Firebase Auth UID with fail-closed isDisabled flag",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "fullName": { "type": "string", "maxLength": 256 },
        "school": { "type": "string", "maxLength": 256 },
        "regionalAcademy": { "type": "string", "maxLength": 256 },
        "province": { "type": "string", "maxLength": 128 },
        "specialty": { "type": "string", "maxLength": 128 },
        "yearsExperience": { "type": "integer", "minimum": 0, "maximum": 80 },
        "role": { "type": "string", "enum": ["teacher", "admin"] },
        "isDisabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "isDisabled", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Server/Console-provisioned Super Administrator record (client writes strictly blocked)",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "fullName": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin"] },
        "isDisabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "fullName", "role", "isDisabled"]
    },
    "Session": {
      "title": "Diagnostic Session (Private Owner Copy)",
      "description": "Teacher-private diagnostic session record",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "ownerRef": { "type": "string", "pattern": "^own_[a-f0-9]{32}$" },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherEmail": { "type": "string", "maxLength": 200 },
        "institution": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "maxLength": 100 },
        "stream": { "type": "string", "maxLength": 100 },
        "class": { "type": "string", "maxLength": 128 },
        "classNumber": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "maxLength": 200 },
        "province": { "type": "string", "maxLength": 120 },
        "isActive": { "type": "boolean" },
        "supervisedMode": { "type": "boolean" },
        "formId": { "type": "string", "maxLength": 120 },
        "formTitle": { "type": "string", "maxLength": 200 },
        "customWeights": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "ownerRef", "teacherId", "class", "isActive", "createdAt", "updatedAt"]
    },
    "PublicSession": {
      "title": "Public Session Lookup",
      "description": "Minimal public session metadata for students without teacherId, teacherEmail, or customWeights",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "ownerRef": { "type": "string", "pattern": "^own_[a-f0-9]{32}$" },
        "title": { "type": "string", "maxLength": 200 },
        "institution": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "maxLength": 100 },
        "stream": { "type": "string", "maxLength": 100 },
        "class": { "type": "string", "maxLength": 128 },
        "classNumber": { "type": "string", "maxLength": 40 },
        "province": { "type": "string", "maxLength": 120 },
        "isActive": { "type": "boolean" },
        "supervisedMode": { "type": "boolean" },
        "formId": { "type": "string", "maxLength": 120 },
        "formTitle": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "ownerRef", "class", "isActive", "updatedAt"]
    },
    "OwnerLink": {
      "title": "Opaque Owner Link",
      "description": "Maps opaque ownerRef tokens to teacherId and sessionId without leaking teacher identity to students",
      "type": "object",
      "properties": {
        "ownerRef": { "type": "string", "pattern": "^own_[a-f0-9]{32}$" },
        "teacherId": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerRef", "teacherId", "sessionId", "createdAt"]
    },
    "Presence": {
      "title": "Student Session Presence",
      "description": "Live session heartbeat keyed by studentAuthUid",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "studentAuthUid": { "type": "string", "maxLength": 128 },
        "studentLabel": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "submitted", "away", "flagged"] },
        "violationCount": { "type": "integer", "minimum": 0, "maximum": 50 },
        "currentQuestionIndex": { "type": "integer", "minimum": 0, "maximum": 100 },
        "lastHeartbeatAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "studentAuthUid", "status", "lastHeartbeatAt"]
    },
    "ViolationEvent": {
      "title": "Advisory Proctoring Violation Event",
      "description": "Append-only advisory integrity event keyed by {studentAuthUid}_{seq}",
      "type": "object",
      "properties": {
        "seq": { "type": "integer", "minimum": 1, "maximum": 50 },
        "studentAuthUid": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["tab_switch", "window_blur", "fullscreen_exit", "copy_paste", "idle_timeout", "devtools_suspect", "focus_lost", "other"] },
        "details": { "type": "string", "maxLength": 400 },
        "advisoryOnly": { "type": "boolean" },
        "occurredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seq", "studentAuthUid", "sessionId", "type", "occurredAt"]
    },
    "Submission": {
      "title": "Student Submission (Option A)",
      "description": "Student diagnostic response bound to deterministic {sessionId}_{studentAuthUid} without privileged Option-B fields",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 200 },
        "studentAuthUid": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "answers": { "type": "object" },
        "analysis": { "type": "object" },
        "signedEnvelope": { "type": "object" },
        "sessionId": { "type": "string", "maxLength": 64 },
        "ownerRef": { "type": "string", "pattern": "^own_[a-f0-9]{32}$" },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherEmail": { "type": "string", "maxLength": 200 },
        "teacherNotes": { "type": "string", "maxLength": 2000 },
        "overriddenClassification": { "type": "string", "maxLength": 100 },
        "deliveryReceiptId": { "type": "string", "maxLength": 64 },
        "deliveredAt": { "type": "string", "format": "date-time" },
        "reliabilityIndex": { "type": "integer", "minimum": 0, "maximum": 100 },
        "institution": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "maxLength": 100 },
        "stream": { "type": "string", "maxLength": 100 },
        "classNumber": { "type": "string", "maxLength": 40 },
        "submittedAt": { "type": "string", "format": "date-time" },
        "cloudSyncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentName", "studentAuthUid", "answers", "analysis", "sessionId", "ownerRef", "submittedAt"]
    },
    "Form": {
      "title": "Questionnaire Form",
      "type": "object",
      "properties": {
        "formId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherEmail": { "type": "string", "maxLength": 200 },
        "questions": { "type": "array" },
        "status": { "type": "string", "enum": ["saved", "published", "ready"] },
        "isTemplate": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["formId", "title", "teacherId", "status", "isTemplate"]
    },
    "Report": {
      "title": "Issue or Pedagogical Feedback Report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterUid": { "type": "string", "maxLength": 128 },
        "reporterName": { "type": "string", "maxLength": 200 },
        "reporterEmail": { "type": "string", "maxLength": 200 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 3000 },
        "imageUrl": { "type": "string", "maxLength": 250000 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterUid", "description", "status", "createdAt"]
    },
    "LandingConfig": {
      "title": "Landing Page Configuration",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroDescription": { "type": "string" },
        "features": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Stats": {
      "title": "Platform Statistics Counters",
      "type": "object",
      "properties": {
        "teachersCount": { "type": "integer", "minimum": 0 },
        "schoolsCount": { "type": "integer", "minimum": 0 },
        "sessionsCount": { "type": "integer", "minimum": 0 },
        "submissionsCount": { "type": "integer", "minimum": 0 },
        "studentsCount": { "type": "integer", "minimum": 0 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teachersCount", "schoolsCount", "sessionsCount", "submissionsCount", "studentsCount"]
    },
    "MigrationOrphan": {
      "title": "Migration Orphan Archive",
      "description": "Admin-only record of legacy JSON records lacking valid parent teacher or session links",
      "type": "object",
      "properties": {
        "sourceFile": { "type": "string" },
        "recordId": { "type": "string" },
        "reason": { "type": "string" },
        "payload": { "type": "object" },
        "archivedAt": { "type": "string", "format": "date-time" }
      }
    },
    "NotificationSettings": {
      "title": "Teacher Notification Settings",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherEmail": { "type": "string", "maxLength": 200 },
        "consentAccepted": { "type": "boolean" },
        "consentTimestamp": { "type": "string", "format": "date-time", "maxLength": 40 },
        "disableAllExternal": { "type": "boolean" },
        "channels": { "type": "object" },
        "emailConfig": { "type": "object" },
        "whatsappConfig": { "type": "object" },
        "messageTypes": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
      },
      "required": ["teacherId", "teacherEmail", "consentAccepted", "disableAllExternal", "channels", "emailConfig", "whatsappConfig", "messageTypes", "updatedAt"]
    },
    "PedagogicalNotification": {
      "title": "Pedagogical Notification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherEmail": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 240 },
        "indicatorType": { "type": "string", "enum": ["critical_thinking_difficulty", "argumentation_weakness", "cognitive_fear_elevation", "low_curiosity_readiness", "class_level_disparity", "individual_follow_up"] },
        "indicatorLabel": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "enum": ["class_alert", "student_alert", "ai_recommendation"] },
        "sessionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sessionTitle": { "type": "string", "maxLength": 200 },
        "classNameLabel": { "type": "string", "maxLength": 120 },
        "gradeLevel": { "type": "string", "maxLength": 120 },
        "summary": { "type": "string", "maxLength": 800 },
        "priority": { "type": "string", "enum": ["عادي", "مهم", "مرتفع"] },
        "recommendation": { "type": "string", "maxLength": 600 },
        "reportPath": { "type": "string", "maxLength": 260 },
        "isRead": { "type": "boolean" },
        "readAt": { "type": "string", "format": "date-time", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 }
      },
      "required": ["id", "teacherId", "teacherEmail", "title", "indicatorType", "indicatorLabel", "category", "sessionId", "sessionTitle", "classNameLabel", "gradeLevel", "summary", "priority", "recommendation", "reportPath", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Teacher profiles indexed by UID with fail-closed isDisabled flag"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Super Administrators (client write locked)"
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Private teacher-owned diagnostic sessions"
    },
    "/publicSessions/{sessionId}": {
      "schema": "PublicSession",
      "description": "Minimal public session metadata for students (contains opaque ownerRef only)"
    },
    "/ownerLinks/{ownerRef}": {
      "schema": "OwnerLink",
      "description": "Opaque mapping between ownerRef and teacherId/sessionId"
    },
    "/sessions/{sessionId}/presence/{studentAuthUid}": {
      "schema": "Presence",
      "description": "Live session heartbeat per anonymous student UID"
    },
    "/sessions/{sessionId}/violationEvents/{eventId}": {
      "schema": "ViolationEvent",
      "description": "Advisory proctoring events keyed by {studentAuthUid}_{seq}"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Student diagnostic submissions (Option A schema)"
    },
    "/forms/{formId}": {
      "schema": "Form",
      "description": "Custom questionnaire forms and standard templates"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Teacher/admin submitted reports with strict imageUrl validation"
    },
    "/config/{configId}": {
      "schema": "LandingConfig",
      "description": "Public landing page configuration (config/landingPage)"
    },
    "/stats/{statId}": {
      "schema": "Stats",
      "description": "Cached platform counters (stats/public)"
    },
    "/migrationOrphans/{orphanId}": {
      "schema": "MigrationOrphan",
      "description": "Legacy orphan records preserved for admin audit"
    },
    "/users/{teacherId}/notificationSettings/{settingId}": {
      "schema": "NotificationSettings",
      "description": "Opt-in pedagogical notification preferences"
    },
    "/users/{teacherId}/notifications/{notificationId}": {
      "schema": "PedagogicalNotification",
      "description": "Pedagogical notifications stream per teacher"
    }
  }
}
