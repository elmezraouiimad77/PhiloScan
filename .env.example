# PORT: Server listening port (Render injects PORT dynamically; local dev defaults to 3000)
PORT=3000

# NODE_ENV: Set to "production" when deploying compiled builds to Render
NODE_ENV="production"

# GEMINI_API_KEY: Required for Gemini AI API calls (free-tier models only: gemini-4-hydrogen & gemini-3.1-flash-lite)
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"

# ANALYSIS_HMAC_SECRET: Dedicated 32+ byte secret for Option A HMAC-SHA256 signing & verification (NEVER share with GEMINI_API_KEY)
ANALYSIS_HMAC_SECRET="REPLACE_WITH_LONG_RANDOM_HMAC_SECRET"

# ADMIN_SECRET_KEY: Optional secret key for emergency admin bootstrap (no default hardcoded password is shipped)
ADMIN_SECRET_KEY="REPLACE_WITH_STRONG_ADMIN_SECRET"

# APP_URL: Public HTTPS URL where PhiloScan is hosted (e.g. https://philoscan.onrender.com)
APP_URL="https://philoscan.onrender.com"

# FIREBASE / APP CHECK HARDENING
FIREBASE_PROJECT_ID="project-ae3ca3a5-d34f-42a5-a4a"
FIREBASE_PROJECT_NUMBER="161687262096"
ALLOWED_APP_IDS="1:161687262096:web:c538d2fd221174a4d19915"
ALLOW_MISSING_APP_CHECK_IN_DEV="true"
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# EMAIL PROVIDERS (Render Free blocks SMTP ports 25/465/587 -> prefer Resend HTTPS API)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# WHATSAPP BUSINESS CLOUD API (Optional - Meta Graph API HTTPS)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
