# PORT: Server listening port (Cloud Run injects 8080 automatically; local dev defaults to 3000)
PORT=3000

# NODE_ENV: Set to "production" when deploying compiled builds to Cloud Run
NODE_ENV="production"

# GEMINI_API_KEY: Required for Gemini AI API calls (configured in Cloud Run / AI Studio Secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL where PhiloScan is hosted on Cloud Run
APP_URL="MY_APP_URL"

# ADMIN_SECRET_KEY: Secret key required to authenticate as Super Admin (configure via Secrets in production)
ADMIN_SECRET_KEY="philoscan2026"
