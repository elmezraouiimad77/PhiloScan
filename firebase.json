{
  "firestore": [
    {
      "database": "ai-studio-d15e3b81-015e-4e2a-bd5c-ec61f18d0bde",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "apphosting": {
    "backendId": "philoscan-web",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "dist",
      ".aistudio",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server.cjs",
      "server.cjs.map"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
