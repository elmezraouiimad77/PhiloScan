rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // GLOBAL SECURITY HELPERS & PRIMITIVES
    // ============================================

    // Default catch-all deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Alphanumeric ID validation protecting against path poisoning & exhaustion attacks
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Context getters
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Active Super-Admin verification check
    // Bootstrapped by static email comparison or dynamic administrative record
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'phillofikr@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Active role validation to check if email matches authenticated context and has registration
    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // ============================================
    // COLLECTION 1: TEACHER PROFILES
    // ============================================
    match /teachers/{teacherId} {
      
      function isValidTeacher(data) {
        return data.email is string && data.email.size() <= 200 &&
               data.fullName is string && data.fullName.size() <= 256 &&
               data.role is string && (data.role == 'teacher' || data.role == 'admin') &&
               (!('school' in data) || (data.school is string && data.school.size() <= 256)) &&
               (!('regionalAcademy' in data) || (data.regionalAcademy is string && data.regionalAcademy.size() <= 256)) &&
               (!('province' in data) || (data.province is string && data.province.size() <= 128));
      }

      // Read access: Restricted to the teacher themselves, or elevated Super Admin
      allow get: if isSignedIn() && (request.auth.uid == teacherId || isAdmin());
      allow list: if isAdmin();

      // Creation safety: Prevent self-assigned admin privileges during initial registration
      allow create: if isSignedIn() && request.auth.uid == teacherId && 
                    isValidTeacher(incoming()) && 
                    (incoming().role == 'teacher' || isAdmin());

      // Update safety: Block editing of immutable system parameters except by Admin
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == teacherId &&
          isValidTeacher(incoming()) &&
          incoming().role == existing().role &&
          incoming().email == existing().email &&
          incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'school', 'regionalAcademy', 'province'])
        )
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION 2: CENTRAL ADMINISTRATORS
    // ============================================
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ============================================
    // COLLECTION 3: DIAGNOSTIC SESSIONS
    // ============================================
    match /sessions/{sessionId} {

      function isValidSession(data) {
        return isValidId(data.sessionId) &&
               data.teacherId is string && data.teacherId.size() <= 128 &&
               data.class is string && data.class.size() <= 128 &&
               data.isActive is bool &&
               (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
               (!('province' in data) || (data.province is string && data.province.size() <= 120)) &&
               (!('institution' in data) || (data.institution is string && data.institution.size() <= 200)) &&
               (!('level' in data) || (data.level is string && data.level.size() <= 100)) &&
               (!('stream' in data) || (data.stream is string && data.stream.size() <= 100)) &&
               (!('formId' in data) || (data.formId is string && data.formId.size() <= 120)) &&
               (!('formTitle' in data) || (data.formTitle is string && data.formTitle.size() <= 200)) &&
               (!('supervisedMode' in data) || data.supervisedMode is bool);
      }

      // Single-document lookup (get) is public so students can resolve the session code.
      // Database lists must be gated to the owner or Super Admin (Query Enforcer).
      allow get: if isValidId(sessionId);
      allow list: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && isValidId(sessionId) && (
        isAdmin() || (
          incoming().teacherId == request.auth.uid &&
          isValidSession(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time
        )
      );

      allow update: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming()) && (
        isAdmin() || (
          existing().teacherId == request.auth.uid &&
          incoming().teacherId == existing().teacherId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'class', 'classNumber', 'institution', 'isActive', 'level', 'stream',
            'title', 'province', 'supervisedMode', 'formId', 'formTitle', 'teacherEmail', 'updatedAt'
          ])
        )
      );

      allow delete: if isSignedIn() && isValidId(sessionId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // ============================================
    // COLLECTION 4: STUDENT DIAGNOSTIC SUBMISSIONS
    // ============================================
    match /submissions/{submissionId} {

      function isValidSubmission(data) {
        return data.studentName is string && data.studentName.size() <= 128 &&
               data.sessionId is string && data.sessionId.size() <= 20 &&
               data.teacherId is string && data.teacherId.size() <= 128 &&
               (!('teacherEmail' in data) || (data.teacherEmail is string && data.teacherEmail.size() <= 200)) &&
               (!('teacherNotes' in data) || (data.teacherNotes is string && data.teacherNotes.size() <= 2000)) &&
               (!('overriddenClassification' in data) || data.overriddenClassification == null || (data.overriddenClassification is string && data.overriddenClassification.size() <= 100)) &&
               (!('deliveryReceiptId' in data) || (data.deliveryReceiptId is string && data.deliveryReceiptId.size() <= 64)) &&
               (!('deliveredAt' in data) || (data.deliveredAt is string && data.deliveredAt.size() <= 40)) &&
               (!('institution' in data) || (data.institution is string && data.institution.size() <= 200)) &&
               (!('level' in data) || (data.level is string && data.level.size() <= 100)) &&
               (!('stream' in data) || (data.stream is string && data.stream.size() <= 100)) &&
               (!('classNumber' in data) || (data.classNumber is string && data.classNumber.size() <= 40)) &&
               (!('reliabilityIndex' in data) || (data.reliabilityIndex is int && data.reliabilityIndex >= 0 && data.reliabilityIndex <= 100));
      }

      // Students submit without log-in if session is active, OR authenticated teacher syncs their own submission record
      allow create: if isValidId(submissionId) && isValidSubmission(incoming()) && (
        isAdmin() || (
          incoming().submittedAt == request.time &&
          get(/databases/$(database)/documents/sessions/$(incoming().sessionId)).data.isActive == true &&
          incoming().teacherId == get(/databases/$(database)/documents/sessions/$(incoming().sessionId)).data.teacherId
        ) || (
          isSignedIn() &&
          incoming().teacherId == request.auth.uid &&
          incoming().cloudSyncedAt == request.time
        )
      );

      // Access restriction: Query Enforcer blocks wide-open reads.
      // Must be owner teacher or Super Admin
      allow get: if isValidId(submissionId) && isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());

      // Moderation adjustments & cloud sync updates by owner teacher
      allow update: if isValidId(submissionId) && isSignedIn() && isValidSubmission(incoming()) && (
        isAdmin() || (
          existing().teacherId == request.auth.uid &&
          incoming().teacherId == existing().teacherId &&
          incoming().sessionId == existing().sessionId &&
          incoming().cloudSyncedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'analysis', 'studentName', 'teacherNotes', 'overriddenClassification',
            'deliveryReceiptId', 'deliveredAt', 'reliabilityIndex', 'institution',
            'level', 'stream', 'classNumber', 'cloudSyncedAt', 'answers', 'teacherEmail'
          ])
        )
      );

      allow delete: if isValidId(submissionId) && isSignedIn() && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // ============================================
    // COLLECTION 5: QUESTIONNAIRE FORMS & TEMPLATES
    // ============================================
    match /forms/{formId} {

      function isValidForm(data) {
        return isValidId(data.formId) &&
               data.title is string && data.title.size() <= 200 &&
               data.teacherId is string && data.teacherId.size() <= 128 &&
               data.teacherEmail is string && data.teacherEmail.size() <= 128 &&
               data.status is string && (data.status == 'saved' || data.status == 'published' || data.status == 'ready');
      }

      // Read access: Anyone can read forms if they know formId, or if listed by signedIn user
      // Query Enforcer: teachers can list all templates/published forms, or their own drafts
      allow get: if isValidId(formId);
      allow list: if isSignedIn() && (
        isAdmin() || (
          request.auth.token.email_verified == true &&
          resource.data.teacherEmail in [request.auth.token.email, "phillofikr@gmail.com"]
        )
      );

      allow create: if isSignedIn() && isValidId(formId) && (
        isAdmin() || (
          request.auth.token.email_verified == true &&
          incoming().teacherEmail == request.auth.token.email &&
          isValidForm(incoming()) &&
          incoming().createdAt is string && incoming().createdAt.size() <= 40 &&
          incoming().updatedAt is string && incoming().updatedAt.size() <= 40
        )
      );

      allow update: if isSignedIn() && isValidId(formId) && (
        isAdmin() || (
          request.auth.token.email_verified == true &&
          existing().teacherEmail == request.auth.token.email &&
          isValidForm(incoming()) &&
          incoming().teacherEmail == existing().teacherEmail &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is string && incoming().updatedAt.size() <= 40 &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'questions', 'status', 'updatedAt',
            'level', 'stream', 'classNumber', 'lessonTopic', 'pedagogicalGoal', 'isTemplate'
          ])
        )
      );

      allow delete: if isSignedIn() && isValidId(formId) && (
        isAdmin() || (
          request.auth.token.email_verified == true &&
          existing().teacherEmail == request.auth.token.email
        )
      );
    }

    // ============================================
    // COLLECTION 6: PUBLIC PLATFORM STATISTICS
    // ============================================
    match /stats/{statId} {
      function isValidStats(data) {
        return data.keys().hasAll(['teachersCount', 'schoolsCount', 'sessionsCount', 'submissionsCount', 'studentsCount', 'updatedAt']) &&
               data.keys().hasOnly(['teachersCount', 'schoolsCount', 'sessionsCount', 'submissionsCount', 'studentsCount', 'updatedAt']) &&
               data.teachersCount is int && data.teachersCount >= 0 &&
               data.schoolsCount is int && data.schoolsCount >= 0 &&
               data.sessionsCount is int && data.sessionsCount >= 0 &&
               data.submissionsCount is int && data.submissionsCount >= 0 &&
               data.studentsCount is int && data.studentsCount >= 0 &&
               data.updatedAt is string && data.updatedAt.size() <= 40;
      }

      allow read: if isValidId(statId);
      allow create, update: if isSignedIn() && isValidId(statId) && isValidStats(incoming());
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION 7: TEACHER NOTIFICATIONS & SETTINGS (OWNER ISOLATED)
    // ============================================
    match /users/{userId} {
      allow read, write: if false;

      match /notificationSettings/{settingId} {
        function isValidNotificationSettings(data) {
          return data.keys().hasAll([
                   'teacherId', 'teacherEmail', 'consentAccepted', 'disableAllExternal',
                   'channels', 'emailConfig', 'whatsappConfig', 'messageTypes', 'updatedAt'
                 ]) &&
                 data.keys().hasOnly([
                   'teacherId', 'teacherEmail', 'consentAccepted', 'consentTimestamp',
                   'disableAllExternal', 'channels', 'emailConfig', 'whatsappConfig',
                   'messageTypes', 'updatedAt'
                 ]) &&
                 isValidId(data.teacherId) &&
                 data.teacherEmail is string && data.teacherEmail.size() <= 200 &&
                 data.consentAccepted is bool &&
                 (!('consentTimestamp' in data) || data.consentTimestamp == null || (data.consentTimestamp is string && data.consentTimestamp.size() <= 40)) &&
                 data.disableAllExternal is bool &&
                 data.channels is map &&
                 data.channels.keys().hasAll(['inApp', 'email', 'whatsapp']) &&
                 data.channels.keys().hasOnly(['inApp', 'email', 'whatsapp']) &&
                 data.channels.inApp is bool &&
                 data.channels.email is bool &&
                 data.channels.whatsapp is bool &&
                 data.emailConfig is map &&
                 data.emailConfig.keys().hasAll(['address', 'verified']) &&
                 data.emailConfig.keys().hasOnly(['address', 'verified', 'lastTestAt']) &&
                 data.emailConfig.address is string && data.emailConfig.address.size() <= 200 &&
                 data.emailConfig.verified is bool &&
                 data.whatsappConfig is map &&
                 data.whatsappConfig.keys().hasAll(['countryCode', 'phoneNumber', 'e164Phone', 'consentAccepted', 'verified']) &&
                 data.whatsappConfig.keys().hasOnly(['countryCode', 'phoneNumber', 'e164Phone', 'consentAccepted', 'consentTimestamp', 'verified', 'lastTestAt']) &&
                 data.whatsappConfig.countryCode is string && data.whatsappConfig.countryCode.size() <= 10 &&
                 data.whatsappConfig.phoneNumber is string && data.whatsappConfig.phoneNumber.size() <= 24 &&
                 data.whatsappConfig.e164Phone is string && data.whatsappConfig.e164Phone.size() <= 32 &&
                 data.whatsappConfig.consentAccepted is bool &&
                 data.whatsappConfig.verified is bool &&
                 data.messageTypes is map &&
                 data.messageTypes.keys().hasAll(['classAlerts', 'studentAlerts', 'aiRecommendations', 'sessionSummaries']) &&
                 data.messageTypes.keys().hasOnly(['classAlerts', 'studentAlerts', 'aiRecommendations', 'sessionSummaries']) &&
                 data.messageTypes.classAlerts is bool &&
                 data.messageTypes.studentAlerts is bool &&
                 data.messageTypes.aiRecommendations is bool &&
                 data.messageTypes.sessionSummaries is bool &&
                 data.updatedAt is string && data.updatedAt.size() <= 40;
        }

        allow get: if isSignedIn() && isValidId(userId) && isValidId(settingId) && (request.auth.uid == userId || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() && isValidId(userId) && isValidId(settingId) &&
                      isValidNotificationSettings(incoming()) && (
                        isAdmin() || (
                          request.auth.uid == userId &&
                          incoming().teacherId == request.auth.uid
                        )
                      );

        allow update: if isSignedIn() && isValidId(userId) && isValidId(settingId) &&
                      isValidNotificationSettings(incoming()) && (
                        isAdmin() || (
                          request.auth.uid == userId &&
                          incoming().teacherId == existing().teacherId &&
                          incoming().teacherId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'consentAccepted', 'consentTimestamp', 'disableAllExternal',
                            'channels', 'emailConfig', 'whatsappConfig', 'messageTypes', 'updatedAt'
                          ])
                        )
                      );

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(settingId) && (request.auth.uid == userId || isAdmin());
      }

      match /notifications/{notificationId} {
        function isValidPedagogicalNotification(data) {
          return data.keys().hasAll([
                   'id', 'teacherId', 'teacherEmail', 'title', 'indicatorType',
                   'indicatorLabel', 'category', 'sessionId', 'sessionTitle',
                   'classNameLabel', 'gradeLevel', 'summary', 'priority',
                   'recommendation', 'reportPath', 'isRead', 'createdAt'
                 ]) &&
                 data.keys().hasOnly([
                   'id', 'teacherId', 'teacherEmail', 'title', 'indicatorType',
                   'indicatorLabel', 'category', 'sessionId', 'sessionTitle',
                   'classNameLabel', 'gradeLevel', 'summary', 'priority',
                   'recommendation', 'reportPath', 'studentRefId',
                   'submissionCountAtTrigger', 'isRead', 'readAt', 'deliveryLog', 'createdAt'
                 ]) &&
                 isValidId(data.id) &&
                 isValidId(data.teacherId) &&
                 data.teacherEmail is string && data.teacherEmail.size() <= 200 &&
                 data.title is string && data.title.size() <= 240 &&
                 data.indicatorType in [
                   'critical_thinking_difficulty', 'argumentation_weakness',
                   'cognitive_fear_elevation', 'low_curiosity_readiness',
                   'class_level_disparity', 'individual_follow_up'
                 ] &&
                 data.indicatorLabel is string && data.indicatorLabel.size() <= 160 &&
                 data.category in ['class_alert', 'student_alert', 'ai_recommendation'] &&
                 isValidId(data.sessionId) &&
                 data.sessionTitle is string && data.sessionTitle.size() <= 200 &&
                 data.classNameLabel is string && data.classNameLabel.size() <= 120 &&
                 data.gradeLevel is string && data.gradeLevel.size() <= 120 &&
                 data.summary is string && data.summary.size() <= 800 &&
                 data.priority in ['عادي', 'مهم', 'مرتفع'] &&
                 data.recommendation is string && data.recommendation.size() <= 600 &&
                 data.reportPath is string && data.reportPath.size() <= 260 &&
                 (!('studentRefId' in data) || (data.studentRefId is string && data.studentRefId.size() <= 128)) &&
                 (!('submissionCountAtTrigger' in data) || (data.submissionCountAtTrigger is int && data.submissionCountAtTrigger >= 0)) &&
                 data.isRead is bool &&
                 (!('readAt' in data) || data.readAt == null || (data.readAt is string && data.readAt.size() <= 40)) &&
                 data.createdAt is string && data.createdAt.size() <= 40;
        }

        allow get: if isSignedIn() && isValidId(userId) && isValidId(notificationId) && (request.auth.uid == userId || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() && isValidId(userId) && isValidId(notificationId) &&
                      isValidPedagogicalNotification(incoming()) && (
                        isAdmin() || (
                          request.auth.uid == userId &&
                          incoming().teacherId == request.auth.uid
                        )
                      );

        allow update: if isSignedIn() && isValidId(userId) && isValidId(notificationId) &&
                      isValidPedagogicalNotification(incoming()) && (
                        isAdmin() || (
                          request.auth.uid == userId &&
                          incoming().teacherId == existing().teacherId &&
                          incoming().createdAt == existing().createdAt &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt'])
                        )
                      );

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(notificationId) && (request.auth.uid == userId || isAdmin());
      }
    }

  }
}
